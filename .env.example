# ─────────────────────────────────────────────────────────────────────────────
# ZerCX AI — Environment Variables Template
#
# Copy this file to .env (never commit .env) and fill in the real values.
# On Replit  : add secrets via the Secrets tab (padlock icon).
# On Netlify : add in Site settings → Environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite — variables must be prefixed with VITE_) ──────────────────

# Supabase project URL  (get it from https://app.supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose in the browser (Row Level Security protects data)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL — point to the Replit production backend
VITE_API_BASE_URL=https://onyx-core--migatitosusu.replit.app

# ── Backend (Node / Express — NOT prefixed with VITE_) ───────────────────────

# PostgreSQL connection string (Replit provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase server-side credentials (same project, same values as VITE_ above)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI API key (or OpenRouter key with sk-or-v1- prefix)
OPENAI_API_KEY=sk-...

# Random secret used for session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=your-random-session-secret

# ── Dev-server only (Replit sets these automatically) ────────────────────────
PORT=3000
BASE_PATH=/
